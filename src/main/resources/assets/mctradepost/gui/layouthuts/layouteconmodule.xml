<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd"
    size="190 244">
    <image source="mctradepost:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text size="130 11" pos="30 14" textalign="MIDDLE" color="black" label="$(com.mctradepost.core.gui.modules.econ)"/>
    <view size="200 243" pos="0 0">
        <dropdown id="intervals"
                  size="129 17"
                  pos="30 30"
                  maxContentHeight="75"
                  dropDownSize="140 75"
                  source="mctradepost:textures/gui/builderhut/builder_button_medium_large.png"
                  color="black">
            <button id="button" size="129 17" pos="0 0" source="mctradepost:textures/gui/builderhut/builder_button_medium_large.png" color="black"
                         label="$(com.mctradepost.coremod.gui.interval.yesterday)"/>
        </dropdown>
        <text size="95 10" pos="20 52" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.currentbalance)"/>
        <text size="50 10" pos="120 52" textalign="MIDDLE_RIGHT" color="black" id="currentbalance"/>

        <button id="withdrawCoin" pos="154 190" size="14 15" label="‡" color="black"
                        source="minecolonies:textures/gui/builderhut/builder_button_mini.png"
                        disabled="minecolonies:textures/gui/builderhut/builder_button_mini_disabled.png"/>

        <text size="95 10" pos="20 64" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.cash.generated)"/>
        <text size="50 10" pos="120 64" textalign="MIDDLE_RIGHT" color="black" id="totalcash"/>
