        <text size="105 10" pos="25 101" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.coin_withdrawal)"/>
        <text size="40 10" pos="130 101" textalign="MIDDLE_RIGHT" color="black" id="expenseCoinWithdrawal"/>
        <text size="105 10" pos="25 111" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.rare_find_purchase)"/>
        <text size="40 10" pos="130 111" textalign="MIDDLE_RIGHT" color="black" id="expenseRareFind"/>
        <text size="105 10" pos="25 121" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.subscription_initial)"/>
        <text size="40 10" pos="130 121" textalign="MIDDLE_RIGHT" color="black" id="expenseSubscriptionInitial"/>
        <text size="105 10" pos="25 131" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.subscription_renewal)"/>
        <text size="40 10" pos="130 131" textalign="MIDDLE_RIGHT" color="black" id="expenseSubscriptionRenewal"/>
        <text size="105 10" pos="25 141" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.rare_find_reroll)"/>
        <text size="40 10" pos="130 141" textalign="MIDDLE_RIGHT" color="black" id="expenseReroll"/>
        <text size="105 10" pos="25 151" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.animal_acquisition)"/>
        <text size="40 10" pos="130 151" textalign="MIDDLE_RIGHT" color="black" id="expenseAnimal"/>
        <text size="105 10" pos="25 161" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.pet_rescue)"/>
        <text size="40 10" pos="130 161" textalign="MIDDLE_RIGHT" color="black" id="expensePetRescue"/>
        <text size="105 10" pos="25 171" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.expense.citizen_incentive)"/>
        <text size="40 10" pos="130 171" textalign="MIDDLE_RIGHT" color="black" id="expenseIncentive"/>

        <text size="70 11" pos="20 194" textalign="MIDDLE_LEFT" color="black" label="$(com.mctradepost.coremod.gui.econ.withdraw.amount)"/>
        <input id="withdrawAmount" size="45 14" pos="90 190" maxlength="6"/>
        <itemicon size="16 16" pos="65 219" color="black" id="coinicon"/>
        <text size="85 16" pos="86 219" textalign="MIDDLE_LEFT" color="black" id="coinvalue"/>
    </view>
</window>
